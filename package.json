{
  "name": "explainer-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source studio that turns a lesson brief into an editable explainer video.",
  "homepage": "https://github.com/BingooAI/explainer-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BingooAI/explainer-studio.git"
  },
  "bugs": "https://github.com/BingooAI/explainer-studio/issues",
  "license": "Apache-2.0",
  "author": "Bingoo.ai (https://bingoo.ai)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4"
  }
}
