{
  "name": "@bingoo.ai/explainer-react",
  "version": "0.0.0",
  "description": "React SVG renderer and player for Explainer Studio. Paints a RenderModel; owns no timing.",
  "license": "Apache-2.0",
  "author": "Bingoo.ai (https://bingoo.ai)",
  "homepage": "https://github.com/BingooAI/explainer-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BingooAI/explainer-studio.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bingoo.ai/explainer-core": "workspace:*",
    "@bingoo.ai/explainer-kernel": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
